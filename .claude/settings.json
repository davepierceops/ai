{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(~/.ssh/**)"
    ]
  }
}
