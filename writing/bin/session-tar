#!/bin/sh
# Tar the whole clone, .git included, to ~/Downloads for session upload.
# Refuses on a dirty tree: every tarball is exactly its SHA.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -n "$(git status --porcelain)" ]; then
  echo "STOP: working tree has uncommitted changes — commit first (wip: is fine), then re-run."
  exit 1
fi
name="writing-$(date +%Y%m%d-%H%M%S).tar.gz"
COPYFILE_DISABLE=1 tar -czf ~/Downloads/"$name" .
echo "wrote ~/Downloads/$name from $(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)"
