#!/bin/sh
# Run the Package A test suite from anywhere.
#
# `-t bin` puts `bin/` on sys.path, so both `import aimeta.frontmatter` and
# `from tests.helpers import ...` resolve without installation.
set -e
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repo_root"
exec python3 -m unittest discover -s bin/tests -t bin "$@"
