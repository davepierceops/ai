#!/usr/bin/env python3
"""Validate frontmatter over the in-scope set; enforce the revision lifecycle.

Contract: `docs/packages/package-a-spec.md` §3.4 and §8.

`--staged` is hook mode and is the one code path in this package that mutates
the git index. Three rules keep that safe:

- **Validate before mutating** (AC-CF-15). Findings are computed on the
  would-be-flipped content first; if anything is wrong, nothing is written.
- **Bytes end to end** (AC-CF-14). The flip reads and writes bytes; the only
  decode is strict, and a document that fails it is reported, never rewritten.
- **Mirror a temporary index** (AC-CF-16). `git commit -- <path>` hands the
  hook a throwaway index; the flip is copied into the real one only while it
  still holds the pre-flip blob.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, frontmatter, repo  # noqa: E402

USAGE_ERROR = cli.EXIT_USAGE

#: git's file mode for a symlink. Its blob is a target path, not a document.
SYMLINK_MODE = "120000"

OVERRIDE_HINT = (
    "commit blocked by the frontmatter policy; "
    "use `git commit --no-verify` to override deliberately"
)


def build_parser():
    p = argparse.ArgumentParser(
        prog="check-frontmatter",
        description=(
            "Validate YAML frontmatter across the in-scope document set, and "
            "in --staged (hook) mode flip agreed -> in-review on content edits."
        ),
    )
    p.add_argument("paths", nargs="*", metavar="PATH", help="documents to check")
    p.add_argument("--staged", action="store_true", help="hook mode: check the index")
    p.add_argument("--all", action="store_true", help="check every in-scope document")
    p.add_argument(
        "--no-flip",
        action="store_true",
        help="in --staged mode, validate only; never mutate the index",
    )
    return p


def findings_for(ctx, relpath, doc):
    return list(doc.errors) + frontmatter.validate(
        doc,
        path=relpath,
        role_slugs=ctx.role_slugs,
        grandfathered=ctx.grandfathered(relpath),
    )


def check_worktree(ctx, relpaths):
    failed = False
    for relpath in relpaths:
        path = ctx.root / relpath
        if not path.is_file():
            cli.diagnostic("ERROR", relpath, "missing-file", "no such file")
            failed = True
            continue
        text, finding = cli.read_document(path)
        if finding is not None:
            cli.report([finding], relpath)
            failed = True
            continue
        findings = findings_for(ctx, relpath, frontmatter.parse_text(text))
        cli.report(findings, relpath)
        failed = failed or bool(findings)
    return cli.EXIT_POLICY if failed else cli.EXIT_OK


# ------------------------------------------------------------------ hook mode


class MirrorError(Exception):
    """The flip could not be carried into the index git is about to install.

    AC-CF-22: this is never absorbed. A silent mirror failure is
    indistinguishable from success and re-opens defect B2 in full.
    """

    def __init__(self, relpath, detail):
        Exception.__init__(self, detail)
        self.relpath = relpath
        self.detail = detail


def mirror_target(ctx):
    """The index git will install, or None when it is the one already flipped.

    During `git commit -a` git *is* using `.git/index.lock` as its working
    index, so the flip has already landed in the file that will become the
    repository index and there is nothing to mirror (AC-CF-24). Comparing the
    flipped blob against itself and reporting that staged work was protected
    would be a false diagnostic.
    """
    override = os.environ.get("GIT_INDEX_FILE")
    current = (
        os.path.abspath(os.path.join(str(ctx.root), override))
        if override
        else repo.real_index_path(ctx.root)
    )
    target = repo.installable_index_path(ctx.root)
    return None if target == current else target


def mirror_into_real_index(ctx, relpath, pre_sha, new_sha):
    """AC-CF-16: carry the flip into the real index, and only over the pre-flip blob."""
    target = mirror_target(ctx)
    if target is None:
        return
    env = {"GIT_INDEX_FILE": target}
    try:
        real_mode, real_sha = repo.index_entry(ctx.root, relpath, env=env)
    except repo.GitError as exc:
        raise MirrorError(relpath, "cannot read %s: %s" % (target, exc))
    if real_sha != pre_sha:
        # The "and only when" half of AC-CF-16: the repository index holds
        # something other than what was flipped, so it is someone else's staged
        # work and is left exactly as it is.
        cli.diagnostic(
            "NOTE",
            relpath,
            "real-index-untouched",
            "the repository index holds a different blob than the one flipped; "
            "leaving it alone rather than clobbering staged work",
        )
        return
    try:
        repo.git(
            "update-index",
            "--cacheinfo",
            "%s,%s,%s" % (real_mode, new_sha, relpath),
            cwd=ctx.root,
            env=env,
        )
    except repo.GitError as exc:
        raise MirrorError(relpath, "cannot write %s: %s" % (target, exc))


def apply_flip(ctx, flip, applied):
    """Write the flipped blob into the index, then mirror it where it belongs.

    Everything undoable is recorded in `applied` *before* it can fail, so a
    mirror failure leaves no half-applied mutation behind (AC-CF-22).
    """
    relpath, mode, pre_sha, staged_bytes, new_bytes = flip
    code, out, error = repo.run(
        ["hash-object", "-w", "--stdin"], cwd=ctx.root, stdin=new_bytes
    )
    if code != 0:
        raise cli.ToolError(
            "cannot write blob for %s: %s" % (relpath, error), cli.EXIT_PRECONDITION
        )
    new_sha = out.decode("ascii").strip()
    repo.git(
        "update-index", "--cacheinfo", "%s,%s,%s" % (mode, new_sha, relpath), cwd=ctx.root
    )
    record = {"relpath": relpath, "mode": mode, "pre_sha": pre_sha,
              "staged_bytes": staged_bytes, "worktree_written": False}
    applied.append(record)

    mirror_into_real_index(ctx, relpath, pre_sha, new_sha)

    worktree = ctx.root / relpath
    try:
        current = worktree.read_bytes()
    except OSError:
        current = None
    if current == staged_bytes:
        worktree.write_bytes(new_bytes)
        record["worktree_written"] = True
    else:
        cli.diagnostic(
            "NOTE",
            relpath,
            "worktree-not-flipped",
            "the worktree copy differs from the index and still claims `agreed`; "
            "the flip landed in the index only",
        )
    cli.err("FLIPPED %s: agreed -> in-review (content edit)" % relpath)


def undo(ctx, applied):
    """Put every applied flip back, newest first, so nothing outlives a failure."""
    for record in reversed(applied):
        relpath = record["relpath"]
        try:
            repo.git(
                "update-index",
                "--cacheinfo",
                "%s,%s,%s" % (record["mode"], record["pre_sha"], relpath),
                cwd=ctx.root,
            )
            if record["worktree_written"]:
                (ctx.root / relpath).write_bytes(record["staged_bytes"])
        except (repo.GitError, OSError) as exc:
            cli.diagnostic(
                "ERROR",
                relpath,
                "rollback-failed",
                "could not undo the flip after an aborted run: %s" % exc,
            )


def would_flip(ctx, relpath, doc, renames):
    """The flipped Document when this staged change is an edit to an agreed doc."""
    if not doc.has_frontmatter or doc.fields.get("status") != "agreed":
        return None
    # AC-CF-18: a rename is compared against the OLD path at HEAD, or renaming
    # and editing in one commit would look like an addition and never flip.
    head_relpath = renames.get(relpath, relpath)
    head_blob = repo.blob_at_rev(ctx.root, "HEAD", head_relpath)
    if head_blob is None:
        return None
    head_text, finding = cli.decode_blob(head_blob)
    if finding is not None:
        cli.diagnostic(
            "NOTE",
            relpath,
            "head-undecodable",
            "the version at HEAD is not valid UTF-8, so no edit comparison is possible",
        )
        return None
    if frontmatter.parse_text(head_text).body == doc.body:
        return None
    return frontmatter.with_fields(doc, {"status": "in-review", "last-reviewed": None})


def check_staged(ctx, no_flip):
    # AC-CF-23: `--staged` is the mode that runs unattended, so it is the one
    # that must say when enforcement has become a no-op. Quiet when it has not.
    if not cli.any_in_scope(ctx):
        cli.diagnostic(
            "WARN",
            "in-scope",
            "empty-scope",
            "the in-scope glob set matches no tracked path in this repo, so this "
            "hook is enforcing nothing; check the metadata policy's Scope section "
            "and $AI_METHODOLOGY_HOME",
        )
    merging = repo.merge_in_progress(ctx.root)
    if merging:
        cli.diagnostic(
            "NOTE",
            "MERGE_HEAD",
            "merge-in-progress",
            "a merge's difference against its first parent is not an authored edit; "
            "validating without flipping, so a review pointer agreed on the merged "
            "branch survives",
        )
    renames = repo.staged_rename_sources(ctx.root)

    failed = False
    planned = []
    for letter, relpath in repo.staged_entries(ctx.root):
        if letter == "D" or not ctx.in_scope(relpath):
            continue
        mode, pre_sha = repo.index_entry(ctx.root, relpath)
        if mode is None:
            continue
        if mode == SYMLINK_MODE:
            cli.diagnostic(
                "NOTE",
                relpath,
                "symlink",
                "staged as a symlink, whose blob is a target path rather than a "
                "document; skipped",
            )
            continue
        staged_bytes = repo.blob_at_rev(ctx.root, ":", relpath)
        if staged_bytes is None:
            continue
        text, finding = cli.decode_blob(staged_bytes)
        if finding is not None:
            cli.report([finding], relpath)
            failed = True
            continue

        doc = frontmatter.parse_text(text)
        flipped = None if (no_flip or merging) else would_flip(ctx, relpath, doc, renames)
        findings = findings_for(ctx, relpath, flipped if flipped is not None else doc)
        if findings:
            cli.report(findings, relpath)
            failed = True
            continue
        if flipped is not None:
            planned.append(
                (
                    relpath,
                    mode,
                    pre_sha,
                    staged_bytes,
                    frontmatter.render(flipped).encode(cli.ENCODING),
                )
            )

    # AC-CF-15: nothing is written until every staged document has passed.
    if failed:
        cli.err("ERROR: %s" % OVERRIDE_HINT)
        return cli.EXIT_POLICY

    applied = []
    for flip in planned:
        try:
            apply_flip(ctx, flip, applied)
        except MirrorError as exc:
            undo(ctx, applied)
            cli.diagnostic(
                "ERROR",
                exc.relpath,
                "real-index-unreachable",
                "the flip could not be carried into the index git will install "
                "(%s). It is therefore NOT in the real index: a later commit "
                "would see no content change and could restore `status: agreed` "
                "with a stale `last-reviewed`. Blocking the commit; every flip "
                "from this run has been undone." % exc.detail,
            )
            return cli.EXIT_POLICY
    return cli.EXIT_OK


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.staged and (args.paths or args.all):
        print("check-frontmatter: --staged takes no paths", file=sys.stderr)
        return USAGE_ERROR

    ctx = cli.load_context()
    if args.staged:
        return check_staged(ctx, args.no_flip)
    if args.paths:
        named = [cli.relpath_of(ctx.root, p) for p in args.paths]
        return check_worktree(ctx, [p for p in named if ctx.in_scope(p)])
    relpaths = cli.in_scope_files(ctx)
    cli.report_scope(ctx, relpaths)
    return check_worktree(ctx, relpaths)


if __name__ == "__main__":
    sys.exit(cli.run(main))
