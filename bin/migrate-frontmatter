#!/usr/bin/env python3
"""F2 transform: legacy `Status:` header -> YAML frontmatter, status-preserving.

STUB — argument surface only; behaviour deliberately inert for the red-gate.
Contract: `docs/packages/package-a-spec.md` §3.8.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import frontmatter, repo, scope  # noqa: E402,F401

USAGE_ERROR = 2


def build_parser():
    p = argparse.ArgumentParser(
        prog="migrate-frontmatter",
        description=(
            "Two-step migration: --plan emits a per-document disposition list "
            "with the judgment fields marked TODO; --apply performs the "
            "mechanical transform once every TODO is resolved."
        ),
    )
    p.add_argument("--plan", action="store_true", help="emit a migration plan")
    p.add_argument("--out", metavar="FILE", help="write the plan here (default: stdout)")
    p.add_argument("--apply", metavar="PLAN", help="apply a completed plan")
    p.add_argument(
        "--dry-run", action="store_true", help="with --apply, print diffs and write nothing"
    )
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if bool(args.plan) == bool(args.apply):
        print(
            "migrate-frontmatter: exactly one of --plan or --apply is required",
            file=sys.stderr,
        )
        return USAGE_ERROR
    # STUB: produces no plan and applies nothing.
    return 0


if __name__ == "__main__":
    sys.exit(main())
