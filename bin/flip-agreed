#!/usr/bin/env python3
"""Self-verifying, frontmatter-only status-transition commit.

Contract: `docs/packages/package-a-spec.md` §3.5.

The tool proves its own claim twice: before committing, the staged body must
equal the body at HEAD; after committing, the committed file must re-validate
and HEAD must touch exactly one path.
"""

import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, expedited, frontmatter, repo  # noqa: E402

TRANSITION_STATUSES = ["agreed", "superseded", "deprecated"]


def build_parser():
    p = argparse.ArgumentParser(
        prog="flip-agreed",
        description=(
            "Flip a document's lifecycle status in a commit that provably "
            "touches nothing but frontmatter."
        ),
    )
    p.add_argument("path", metavar="PATH", help="document to transition")
    p.add_argument(
        "--review",
        metavar="'reviews/<file>.md @ <sha>'",
        help="review artifact pointer; required for --status agreed",
    )
    p.add_argument(
        "--status",
        choices=TRANSITION_STATUSES,
        default="agreed",
        help="target status (default: agreed)",
    )
    p.add_argument("--superseded-by", metavar="PATH", help="successor document")
    p.add_argument("--message", metavar="MSG", help="override the commit subject")
    p.add_argument(
        "--no-commit", action="store_true", help="stage the flip but do not commit"
    )
    return p


def check_review(ctx, review):
    """AC-FA-5: format, artifact existence, and SHA resolution.

    AC-EL-1/2/3: when the artifact is the expedited log, existence is not
    enough — the log exists permanently, so it is satisfied vacuously and
    forever. The cited SHA must be named by an entry, compared after
    normalization rather than as a string. Any other artifact keeps
    existence-only behaviour.
    """
    if not re.match(frontmatter.LAST_REVIEWED_RE, review):
        raise cli.ToolError(
            "review pointer %r is not `<reviews/path.md> @ <sha>`" % review,
            cli.EXIT_POLICY,
        )
    artifact, _, sha = review.partition(" @ ")
    if not (ctx.root / artifact).is_file():
        raise cli.ToolError("review artifact %s does not exist" % artifact, cli.EXIT_POLICY)
    code, _, _ = repo.run(["rev-parse", "--verify", "%s^{commit}" % sha], cwd=ctx.root)
    if code != 0:
        raise cli.ToolError(
            "review SHA %s does not resolve to a commit" % sha, cli.EXIT_POLICY
        )
    findings = expedited.check_pointer(ctx.root, review)
    if findings:
        cli.report(findings, artifact)
        raise cli.ToolError(
            "review pointer %r does not resolve to an entry in %s"
            % (review, expedited.LOG_PATH),
            cli.EXIT_POLICY,
        )


def check_preconditions(ctx, relpath):
    """AC-FA-3 / AC-FA-4: nothing unrelated staged, no unstaged body edits."""
    others = sorted({p for _, p in repo.staged_entries(ctx.root) if p != relpath})
    if others:
        raise cli.ToolError(
            "refusing to commit with unrelated staged changes: %s" % ", ".join(others),
            cli.EXIT_PRECONDITION,
        )
    staged_text = repo.file_at_rev(ctx.root, ":", relpath)
    worktree_text, finding = cli.read_document(ctx.root / relpath)
    if finding is not None:
        cli.report([finding], relpath)
        raise cli.ToolError("%s cannot be read as a document" % relpath, cli.EXIT_POLICY)
    if staged_text is not None:
        if frontmatter.parse_text(staged_text).body != frontmatter.parse_text(worktree_text).body:
            raise cli.ToolError(
                "%s has unstaged body edits in the worktree" % relpath,
                cli.EXIT_PRECONDITION,
            )
    return worktree_text


def restore(ctx, relpath, original_text, original_entry):
    """D6: put the worktree file and this path's index entry back as they were."""
    (ctx.root / relpath).write_text(original_text, encoding=cli.ENCODING)
    if original_entry is None:
        repo.git("update-index", "--force-remove", "--", relpath, cwd=ctx.root)
    else:
        repo.git("update-index", "--cacheinfo", original_entry, cwd=ctx.root)


def staged_entry(ctx, relpath):
    """`<mode>,<sha>,<path>` for the current index entry, or None if absent."""
    entry = repo.git("ls-files", "--stage", "--", relpath, cwd=ctx.root)
    if not entry:
        return None
    mode, sha = entry.split()[0], entry.split()[1]
    return "%s,%s,%s" % (mode, sha, relpath)


def commit_message(relpath, status, review, override):
    subject = override or "docs(%s): status -> %s" % (relpath, status)
    body = "Status transition only; no content change."
    if review:
        body = "Review: %s\n\n%s" % (review, body)
    return subject, body


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.status == "agreed" and not args.review:
        raise cli.ToolError("--review is required for --status agreed", cli.EXIT_USAGE)
    if args.status == "superseded" and not args.superseded_by:
        raise cli.ToolError(
            "--superseded-by is required for --status superseded", cli.EXIT_USAGE
        )

    ctx = cli.load_context()
    relpath = cli.relpath_of(ctx.root, args.path)
    if not ctx.in_scope(relpath):
        raise cli.ToolError(
            "%s is outside the frontmatter in-scope set" % relpath, cli.EXIT_POLICY
        )
    if not (ctx.root / relpath).is_file():
        raise cli.ToolError("%s does not exist" % relpath, cli.EXIT_POLICY)
    if args.review:
        check_review(ctx, args.review)

    original_text = check_preconditions(ctx, relpath)
    original_entry = staged_entry(ctx, relpath)

    doc = frontmatter.parse_text(original_text)
    if not doc.has_frontmatter:
        cli.diagnostic(
            "ERROR", relpath, "missing-frontmatter", "no frontmatter block to transition"
        )
        return cli.EXIT_POLICY

    updates = {"status": args.status}
    if args.review:
        updates["last-reviewed"] = args.review
    if args.superseded_by:
        updates["superseded-by"] = args.superseded_by
    flipped = frontmatter.with_fields(doc, updates)

    findings = list(flipped.errors) + frontmatter.validate(
        flipped,
        path=relpath,
        role_slugs=ctx.role_slugs,
        grandfathered=ctx.grandfathered(relpath),
    )
    if findings:
        cli.report(findings, relpath)
        return cli.EXIT_POLICY

    (ctx.root / relpath).write_text(frontmatter.render(flipped), encoding=cli.ENCODING)
    repo.git("add", "--", relpath, cwd=ctx.root)

    # AC-FA-2: the staged change must be frontmatter-only against HEAD.
    head_text = repo.file_at_rev(ctx.root, "HEAD", relpath)
    staged_text = repo.file_at_rev(ctx.root, ":", relpath)
    if head_text is not None and (
        frontmatter.parse_text(head_text).body != frontmatter.parse_text(staged_text or "").body
    ):
        restore(ctx, relpath, original_text, original_entry)
        cli.diagnostic(
            "ERROR",
            relpath,
            "frontmatter-only-violation",
            "the staged body differs from HEAD; refusing to launder a content edit",
        )
        return cli.EXIT_SELF_VERIFY

    if args.no_commit:
        return cli.EXIT_OK

    subject, body = commit_message(relpath, args.status, args.review, args.message)
    code, _, error = repo.run(
        ["commit", "-q", "-m", subject, "-m", body], cwd=ctx.root
    )
    if code != 0:
        # AC-FA-13: a rejected commit must not leave a mutation behind.
        restore(ctx, relpath, original_text, original_entry)
        cli.diagnostic(
            "ERROR",
            relpath,
            "commit-failed",
            "git commit failed (%s); the working tree and index were restored"
            % error.strip().replace("\n", " "),
        )
        return cli.EXIT_PRECONDITION

    # AC-FA-11 + AC-FA-12: the commit must be what was promised — it re-validates,
    # it touches exactly one path, and its body is the parent's body untouched.
    # Kept to a single comparison so it is verifiable by reading (spec §6).
    committed = frontmatter.parse_text(repo.file_at_rev(ctx.root, "HEAD", relpath) or "")
    parent = repo.file_at_rev(ctx.root, "HEAD~1", relpath)
    parent_body = frontmatter.parse_text(parent).body if parent is not None else committed.body
    recheck = frontmatter.validate(
        committed,
        path=relpath,
        role_slugs=ctx.role_slugs,
        grandfathered=ctx.grandfathered(relpath),
    )
    touched = [
        p
        for p in repo.git("show", "--pretty=format:", "--name-only", "HEAD", cwd=ctx.root).splitlines()
        if p.strip()
    ]
    if (recheck, touched, committed.body) != ([], [relpath], parent_body):
        cli.diagnostic(
            "ERROR",
            relpath,
            "post-commit-verification-failed",
            "the commit does not match what was staged (touched %s, %d finding(s), "
            "body %s); the commit is left in place for inspection"
            % (touched, len(recheck), "changed" if committed.body != parent_body else "intact"),
        )
        return cli.EXIT_SELF_VERIFY
    return cli.EXIT_OK


if __name__ == "__main__":
    sys.exit(cli.run(main))
